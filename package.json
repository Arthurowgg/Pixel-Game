{
  "name": "wildpine",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs && node scripts/workshop-browser-test.mjs && node scripts/embers-browser-test.mjs && node scripts/roots-browser-test.mjs",
    "format": "prettier --write src scripts/*.mjs .github index.html vite.config.ts tsconfig.json package.json README.md ART_ROADMAP.md public/art/animations/README.md public/art/ui/README.md",
    "build:pages": "tsc -b && vite build --base=/Pixel-Game/ && node scripts/check-pages-build.mjs",
    "preview:pages": "vite preview --host 0.0.0.0 --base=/Pixel-Game/"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/pixelify-sans": "^5.2.7",
    "@fontsource/space-mono": "^5.2.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^5.1.0"
  }
}
